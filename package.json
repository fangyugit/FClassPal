{
  "name": "FClassPal",
  "version": "2.5.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir",
    "build:portable": "electron-builder --win portable",
    "build:linux": "electron-builder --linux",
    "build:loong64": "electron-builder --linux --dir && node make-loong64.js",
    "build:mac": "electron-builder --mac"
  },
  "author": "YU",
  "license": "MIT",
  "build": {
    "appId": "top.fangyum.classpal",
    "productName": "FClassPal",
    "artifactName": "FClassPal-${version}.exe",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "pack.js",
      "themes.js",
      "themes/kitty.fcpt",
      "themes/dog.fcpt",
      "themes/kuromi.fcpt",
      "themes/melody.fcpt",
      "themes/sanrio.fcpt",
      "themes/pochacco.fcpt",
      "themes/purin.fcpt",
      "themes/NaiWa.fcpt",
      "renderer/**/*",
      "!renderer/theme/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "compression": "maximum",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "YU",
      "synopsis": "轻量桌面快捷面板（液态玻璃 / 主题包生态）",
      "description": "FClassPal：无边框桌面小部件，右键 / 长按呼出菜单，支持触摸屏、透明度与尺寸调节、自定义快捷键、U 盘弹出。",
      "artifactName": "FClassPal-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon-512.png",
      "artifactName": "FClassPal-${version}-mac-${arch}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "@material/material-color-utilities": "^0.4.0"
  }
}

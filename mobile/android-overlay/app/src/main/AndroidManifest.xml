<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     FClassPal 安卓壳 · 清单
     与 Capacitor 模板的差异（都有注释说明为什么）：
       1. <queries>：Android 11 起 queryIntentActivities 必须在清单里声明要查的
          Intent，否则"已安装应用列表 / 应用图标 / 按名称启动"全部查不到（静默返回
          空列表，不是报错——更难排查）。
       2. windowSoftInputMode=adjustResize：设置面板底部有输入框，键盘弹出时把
          面板顶上来，别盖住。
       3. 不申请任何存储/定位权限：界面里没有需要权限的能力（壁纸是公开 API，
          应用列表走 queries 声明）。
     ==========================================================================-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 悬浮窗实时模糊的采集前台服务（Android 14+ 硬性要求，见类注释） -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 悬浮窗实时模糊（v2.4.6）：MediaProjection 录屏采集。Android 14 起采集期间
         必须有一个 foregroundServiceType="mediaProjection" 的前台服务在跑
         （ScreenCaptureService），所以连着 FOREGROUND_SERVICE 一起声明。
         POST_NOTIFICATIONS 只是让"正在采集"的常驻通知可见，不授权也能采。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ 包可见性：只声明"桌面类应用"这一种 Intent，
         覆盖所有有入口的 App，不需要 QUERY_ALL_PACKAGES 这个敏感权限 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>

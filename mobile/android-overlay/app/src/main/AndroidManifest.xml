<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     FClassPal 安卓壳 · 清单
     与 Capacitor 模板的差异（都有注释说明为什么）：
       1. <queries>：Android 11 起 queryIntentActivities 必须在清单里声明要查的
          Intent，否则"已安装应用列表 / 应用图标 / 按名称启动"全部查不到（静默返回
          空列表，不是报错——更难排查）。
       2. windowSoftInputMode=adjustResize：设置面板底部有输入框，键盘弹出时把
          面板顶上来，别盖住。
       3. SYSTEM_ALERT_WINDOW（v2.5.2 补）：不声明它，应用就**不会出现在**系统
          设置的「显示在其他应用上层」列表里 —— overlayGranted 永远是 false、
          用户想授权都没地方点。声明后悬浮窗授权入口才找得到本应用。
       4. 存储权限（v2.5.2 补）：主题包等文件落在应用专属目录
          Android/data/com.fclasspal.widget/files/themes（本应用免权限可写），
          READ/WRITE_EXTERNAL_STORAGE 只为 SAF 之外的旧路径/文件管理器兜底；
          SAF 选包（ACTION_OPEN_DOCUMENT）本身不需要这两个权限。
     ==========================================================================-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 悬浮窗实时模糊的采集前台服务（Android 14+ 硬性要求，见类注释） -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 悬浮窗实时模糊（v2.4.6）：MediaProjection 录屏采集。Android 14 起采集期间
         必须有一个 foregroundServiceType="mediaProjection" 的前台服务在跑
         （ScreenCaptureService），所以连着 FOREGROUND_SERVICE 一起声明。
         POST_NOTIFICATIONS 只是让"正在采集"的常驻通知可见，不授权也能采。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- v2.5.2：悬浮窗（「显示在其他应用上层」）+ 存储兜底。
         SYSTEM_ALERT_WINDOW 不写，系统设置列表里根本找不到本应用（v2.5.0 的教训）。
         存储权限只在 API ≤32 生效（33+ 分区存储下 Android/data 目录本应用免权限）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 11+ 包可见性：只声明"桌面类应用"这一种 Intent，
         覆盖所有有入口的 App，不需要 QUERY_ALL_PACKAGES 这个敏感权限 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>

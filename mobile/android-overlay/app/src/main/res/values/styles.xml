<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     FClassPal 安卓壳 · 主题
     关键点：窗口背景用 @color/window_bg（明亮/黑暗各一份，见 values-night/）。
     WebView 加载首帧到壁纸底材就位之间会露出窗口背景，给一个和界面同族的颜色，
     就不会有"白一下/黑一下"的闪屏。
     ==========================================================================-->
<resources>

    <!-- v2.6.8-fix3：应用级主题也改成 NoActionBar。
         Activity 自己挂的是 NoActionBarLaunch（启动屏主题），但只要有**任何**
         路径回落到 application 主题（例如某个 ROM 上启动屏主题解析失败、
         或者将来有人新增 Activity 忘了写 theme），DarkActionBar 就会给出一条
         带应用名的原生标题条 —— 用户报的就是"页面顶部出现原生标题条"。
         这里直接断掉回落的可能：application 层就没有 ActionBar 可给。 -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <!-- 实际使用的主题：无标题栏 + 状态栏/导航栏沉浸（内容画到系统栏底下，
         网页里用 env(safe-area-inset-*) 让开刘海与手势条） -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 启动屏：不用模板自带的蓝色 splash 图，直接用 window_bg，
         视觉上就是"界面从底色里淡入" -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/window_bg</item>
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- v2.6.9b：WearOS 版界面（纯 framework 主题，不依赖 AppCompat；
         深底无 ActionBar，观感由 com.fclasspal.wear.MainActivity 代码里的配色给） -->
    <style name="WearTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#FF0D1014</item>
        <item name="android:colorAccent">#FFA8C7FA</item>
        <item name="android:statusBarColor">#FF0D1014</item>
        <item name="android:navigationBarColor">#FF0D1014</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
